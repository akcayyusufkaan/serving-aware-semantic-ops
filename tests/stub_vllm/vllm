#!/usr/bin/env python3
"""Stand-in for `vllm serve` used to test the harness and launchers without a GPU.

Implements /health, /metrics, /sleep, /wake_up, /reset_prefix_cache, /tokenize and
/v1/chat/completions. Like vLLM, it rejects a completion whose prompt plus max_tokens exceeds
--max-model-len, and it fails any completion request sent to a sleeping server.
"""
import json
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# Category names for Palimpzest-format answers: from the repository, or from the working
# directory when the stub is installed elsewhere (Dockerfile.cpu copies it to /usr/local/bin).
sys.path[:0] = [os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."), os.getcwd()]
try:
    from harness.cuad import NAMES
except ImportError:
    NAMES = ["Document Name"]

port = int(sys.argv[sys.argv.index("--port") + 1])
max_model_len = int(sys.argv[sys.argv.index("--max-model-len") + 1]) if "--max-model-len" in sys.argv else 4096


def n_tokens(req):
    return len(json.dumps(req.get("messages", []))) // 4   # rough stand-in for the tokenizer
state = {"queries": 0, "hits": 0, "asleep": False}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _send(self, body, status=200, content_type="text/plain"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/metrics":
            self._send((f'vllm:prefix_cache_queries_total{{model_name="stub"}} {state["queries"]}\n'
                        f'vllm:prefix_cache_hits_total{{model_name="stub"}} {state["hits"]}\n').encode())
        else:
            self._send(b"ok")

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length)
        if self.path.startswith("/sleep"):
            state["asleep"] = True
            return self._send(b"ok")
        if self.path.startswith("/wake_up"):
            state["asleep"] = False
            return self._send(b"ok")
        if self.path.startswith("/reset_prefix_cache"):
            return self._send(b"ok")
        if self.path.startswith("/tokenize"):
            return self._send(json.dumps({"count": n_tokens(json.loads(body)), "max_model_len": max_model_len}).encode(),
                              content_type="application/json")
        if state["asleep"]:
            return self._send(b"server is asleep", status=409)
        req = json.loads(body) if body else {}
        if n_tokens(req) + (req.get("max_tokens") or 0) > max_model_len:
            return self._send(b'{"error": "max_tokens is too large"}', status=400, content_type="application/json")
        if os.environ.get("STUB_LOG"):
            with open(os.environ["STUB_LOG"], "a") as f:
                f.write(json.dumps({"port": port, "chars": len(body),
                                    "max_tokens": json.loads(body).get("max_tokens")}) + "\n")
        state["queries"] += 100
        state["hits"] += 50
        content = "ok"
        messages = json.loads(body)["messages"] if body else []
        prompt = messages[0]["content"] if messages and isinstance(messages[0].get("content"), str) else ""
        if "Excerpt:" in prompt:
            # Quote the first line of the excerpt as the document name, so CUAD scoring has something to match.
            excerpt = prompt.split("Excerpt:", 1)[1].strip().split("\n")[0]
            content = json.dumps({"Document Name": [excerpt]})
        elif "ANSWER" in json.dumps(messages):
            # Palimpzest's answer format.
            answer = {name: [] for name in NAMES}
            answer["Document Name"] = ["stub"]
            content = f"REASONING: stub\nANSWER:\n```json\n{json.dumps(answer)}\n```\n---"

        self._send(json.dumps({
            "id": "stub", "object": "chat.completion", "created": 0, "model": (json.loads(body) if body else {}).get("model", "stub"),
            "choices": [{"index": 0, "finish_reason": "stop", "message": {"role": "assistant", "content": content}}],
            "usage": {"prompt_tokens": 100, "completion_tokens": 2, "prompt_tokens_details": {"cached_tokens": 50}},
        }).encode(), content_type="application/json")


ThreadingHTTPServer.request_queue_size = 256
ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
