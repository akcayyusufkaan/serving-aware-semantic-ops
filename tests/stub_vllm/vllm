#!/usr/bin/env python3
"""Stand-in for `vllm serve` used to test the harness and launchers without a GPU.

Implements /health, /metrics, /sleep, /wake_up, /reset_prefix_cache and /v1/chat/completions,
and fails any completion request sent to a sleeping server.
"""
import json
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

port = int(sys.argv[sys.argv.index("--port") + 1])
state = {"queries": 0, "hits": 0, "asleep": False}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _send(self, body, status=200, content_type="text/plain"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/metrics":
            self._send((f'vllm:prefix_cache_queries_total{{model_name="stub"}} {state["queries"]}\n'
                        f'vllm:prefix_cache_hits_total{{model_name="stub"}} {state["hits"]}\n').encode())
        else:
            self._send(b"ok")

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        self.rfile.read(length)
        if self.path.startswith("/sleep"):
            state["asleep"] = True
            return self._send(b"ok")
        if self.path.startswith("/wake_up"):
            state["asleep"] = False
            return self._send(b"ok")
        if self.path.startswith("/reset_prefix_cache"):
            return self._send(b"ok")
        if state["asleep"]:
            return self._send(b"server is asleep", status=409)
        state["queries"] += 100
        state["hits"] += 50
        self._send(json.dumps({
            "choices": [{"message": {"content": "ok"}}],
            "usage": {"prompt_tokens": 100, "completion_tokens": 2, "prompt_tokens_details": {"cached_tokens": 50}},
        }).encode(), content_type="application/json")


ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
